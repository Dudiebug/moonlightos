#!/bin/bash
set -Eeuo pipefail

# Debian live-build intentionally waits forever at its default boot menus.
# An appliance must select the live entry without a keyboard, for both BIOS
# (isolinux) and x86_64 UEFI (GRUB).
while IFS= read -r -d '' cfg; do
  sed -i '/^set default=/d; /^set timeout=/d; /^serial --unit=0 /d; /^terminal_input console serial$/d; /^terminal_output console serial$/d' "$cfg"
  sed -i '1i set default=0\nset timeout=3\nserial --unit=0 --speed=115200 --word=8 --parity=no --stop=1\nterminal_input console serial\nterminal_output console serial' "$cfg"
done < <(find . -type f -name grub.cfg -print0)

while IFS= read -r -d '' cfg; do
  sed -i 's/menuentry "Live system (amd64)"/menuentry "Start MoonlightOS"/' "$cfg"
  grep -Fq 'menuentry "Start MoonlightOS (No Persistence)"' "$cfg" && continue
  output=$(mktemp "${cfg}.XXXXXX")
  awk '
    /^menuentry "Start MoonlightOS"/ && !done { capture=1 }
    capture { block=block $0 ORS }
    capture && /^}/ {
      printf "%s", block
      sub(/"Start MoonlightOS"[^\{]*/, "\"Start MoonlightOS (No Persistence)\" ", block)
      gsub(/ persistence /, " nopersistence ", block)
      printf "%s", block
      block=""; capture=0; done=1; next
    }
    !capture { print }
  ' "$cfg" > "$output"
  mv "$output" "$cfg"
done < <(find . -type f -path '*/boot/grub/grub.cfg' -print0)

while IFS= read -r -d '' cfg; do
  sed -i "s/menuentry 'Start installer'/menuentry 'Install MoonlightOS'/" "$cfg"
done < <(find . -type f -path '*/boot/grub/install_start.cfg' -print0)

while IFS= read -r -d '' cfg; do
  sed -i '/^timeout /d' "$cfg"
  printf '\ntimeout 30\n' >> "$cfg"
done < <(find . -type f -name isolinux.cfg -print0)

while IFS= read -r -d '' cfg; do
  grep -Fq 'menu label Start MoonlightOS (No Persistence)' "$cfg" && continue
  output=$(mktemp "${cfg}.XXXXXX")
  awk 'BEGIN { RS=""; ORS="\n\n" }
    $1 == "label" && $2 == "live-amd64" {
      gsub(/menu label \^Live system \(amd64\)/, "menu label ^Start MoonlightOS")
      print
      sub(/^label live-amd64/, "label live-amd64-nopersistence")
      gsub(/menu label \^Start MoonlightOS/, "menu label Start MoonlightOS (No Persistence)")
      gsub(/\n[[:space:]]*menu default/, "")
      gsub(/ persistence /, " nopersistence ")
      print
      next
    }
    { print }
  ' "$cfg" > "$output"
  mv "$output" "$cfg"
done < <(find . -type f -path '*/isolinux/live.cfg' -print0)

while IFS= read -r -d '' cfg; do
  sed -i 's/menu label Start \^installer/menu label ^Install MoonlightOS/' "$cfg"
done < <(find . -type f -path '*/isolinux/install.cfg' -print0)
