#!/bin/bash
set -Eeuo pipefail

# Debian live-build intentionally waits forever at its default boot menus.
# An appliance must select the live entry without a keyboard, for both BIOS
# (isolinux) and x86_64 UEFI (GRUB).
while IFS= read -r -d '' cfg; do
  sed -i '/^set default=/d; /^set timeout=/d' "$cfg"
  sed -i '1i set default=0\nset timeout=5' "$cfg"
done < <(find binary -type f -name grub.cfg -print0)

while IFS= read -r -d '' cfg; do
  sed -i '/^timeout /d' "$cfg"
  printf '\ntimeout 50\n' >> "$cfg"
done < <(find binary -type f -name isolinux.cfg -print0)
