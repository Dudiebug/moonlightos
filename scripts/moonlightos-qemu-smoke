#!/bin/bash
set -Eeuo pipefail

flag=/sys/firmware/qemu_fw_cfg/by_name/opt/moonlightos.smoke/raw
[[ -r "$flag" ]] || exit 0
[[ $(tr -d '\0' < "$flag") == apps ]] || exit 0

wait_for_file() {
  local path=$1 label=$2
  for _ in $(seq 1 450); do
    [[ -e "$path" ]] && return 0
    sleep 0.1
  done
  echo "QEMU smoke test timed out waiting for $label" >&2
  exit 1
}

wait_for_file /run/moonlightos/launcher-ready launcher
for _ in $(seq 1 250); do
  if systemctl is-failed --quiet moonlightos-usbipd.service; then
    systemctl --no-pager --full status moonlightos-usbipd.service >&2 || true
    echo 'USB/IP daemon failed during QEMU smoke test.' >&2
    exit 1
  fi
  if systemctl is-active --quiet moonlightos-usbipd.service; then
    echo MOONLIGHTOS_SMOKE_USBIP_READY
    break
  fi
  sleep 0.1
done
systemctl is-active --quiet moonlightos-usbipd.service || {
  systemctl --no-pager --full status moonlightos-usbipd.service >&2 || true
  echo 'USB/IP daemon did not become active during QEMU smoke test.' >&2
  exit 1
}

wait_for_bluetooth_service() {
  for _ in $(seq 1 100); do
    if systemctl is-active --quiet moonlightos-bluetooth.service && \
      /usr/libexec/moonlightos-bluetoothd --snapshot \
        > /tmp/moonlightos-bluetooth-smoke.txt 2>&1; then
      cat /tmp/moonlightos-bluetooth-smoke.txt
      return 0
    fi
    sleep 0.1
  done
  systemctl --no-pager --full status moonlightos-bluetooth.service >&2 || true
  cat /tmp/moonlightos-bluetooth-smoke.txt >&2 || true
  echo 'Bluetooth control service did not become ready without an adapter.' >&2
  return 1
}
wait_for_bluetooth_service
launcher_pid=$(systemctl show --property=MainPID --value moonlightos-launcher.service)
launcher_restarts=$(systemctl show --property=NRestarts --value moonlightos-launcher.service)
audio_pid=$(systemctl show --property=MainPID --value moonlightos-audio.service)
audio_restarts=$(systemctl show --property=NRestarts --value moonlightos-audio.service)
systemctl restart bluetooth.service
systemctl restart moonlightos-bluetooth.service
wait_for_bluetooth_service
test "$launcher_pid" = "$(systemctl show --property=MainPID --value moonlightos-launcher.service)"
test "$launcher_restarts" = "$(systemctl show --property=NRestarts --value moonlightos-launcher.service)"
test "$audio_pid" = "$(systemctl show --property=MainPID --value moonlightos-audio.service)"
test "$audio_restarts" = "$(systemctl show --property=NRestarts --value moonlightos-audio.service)"
runuser -u moonlightos -- env XDG_RUNTIME_DIR=/run/moonlightos \
  wpctl status > /tmp/moonlightos-audio-smoke.txt 2>&1 || {
  systemctl --no-pager --full status moonlightos-audio.service >&2 || true
  cat /var/log/moonlightos/audio.log >&2 || true
  cat /tmp/moonlightos-audio-smoke.txt >&2 || true
  echo 'PipeWire did not remain ready after Bluetooth service restarts.' >&2
  exit 1
}
echo MOONLIGHTOS_SMOKE_BLUETOOTH_READY

systemctl start --no-block moonlightos-moonlight.service
wait_for_file /run/moonlightos/moonlight-ready Moonlight
systemctl stop moonlightos-moonlight.service
systemctl start --no-block moonlightos-chiaki.service
wait_for_file /run/moonlightos/chiaki-ng-ready chiaki-ng
systemctl stop moonlightos-chiaki.service
systemctl start --no-block moonlightos-firefox.service
wait_for_file /run/moonlightos/firefox-ready Firefox
echo MOONLIGHTOS_SMOKE_APPS_READY
