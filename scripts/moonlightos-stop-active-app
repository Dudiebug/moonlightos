#!/bin/bash
set -Eeuo pipefail

request=/run/moonlightos/stop-active-app
active=/run/moonlightos/app-active
rm -f -- "$request"

[[ -f "$active" && ! -L "$active" ]] || exit 0
[[ $(stat -c '%s' "$active") -le 64 ]] || exit 1
app=$(head -n 1 "$active" | tr -d '\r\n')
case "$app" in
  moonlight) unit=moonlightos-moonlight.service ;;
  chiaki-ng) unit=moonlightos-chiaki.service ;;
  firefox) unit=moonlightos-firefox.service ;;
  *) exit 0 ;;
esac

printf 'Triple-Esc requested launcher return from %s\n' "$app"
systemctl stop "$unit"
