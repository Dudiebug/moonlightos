[Unit]
Description=MoonlightOS Bluetooth control service
Wants=bluetooth.service
After=dbus.service bluetooth.service
Before=moonlightos-launcher.service

[Service]
Type=simple
User=moonlightos
Group=moonlightos
Environment=HOME=/var/lib/moonlightos/home
Environment=XDG_RUNTIME_DIR=/run/moonlightos
RuntimeDirectory=moonlightos-bluetooth
RuntimeDirectoryMode=0700
ExecStart=/usr/libexec/moonlightos-bluetoothd
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
ReadWritePaths=/run/moonlightos-bluetooth /var/lib/moonlightos
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
