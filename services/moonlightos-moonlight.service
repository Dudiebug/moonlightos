[Unit]
Description=MoonlightOS Moonlight client
After=moonlightos-launcher.service
ConditionFileIsExecutable=/opt/moonlightos/apps/moonlight/usr/bin/moonlight
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=moonlightos
Group=moonlightos
SupplementaryGroups=audio input render video
Environment=HOME=/var/lib/moonlightos/home
Environment=XDG_CONFIG_HOME=/var/lib/moonlightos/home/.config
Environment=XDG_DATA_HOME=/var/lib/moonlightos/home/.local/share
Environment=XDG_CACHE_HOME=/var/lib/moonlightos/home/.cache
Environment=XDG_RUNTIME_DIR=/run/moonlightos
Environment=DISPLAY=:0
Environment=QT_QPA_PLATFORM=xcb
EnvironmentFile=-/run/moonlightos/session.env
ExecStart=/usr/libexec/moonlightos-run-app moonlight
Restart=on-failure
RestartSec=2
StandardOutput=journal+console
StandardError=journal+console
