[Unit]
Description=MoonlightOS buffered on-screen keyboard
After=moonlightos-launcher.service
ConditionPathExists=/run/moonlightos/start-osk

[Service]
Type=simple
User=moonlightos
Group=moonlightos
SupplementaryGroups=input
Environment=HOME=/var/lib/moonlightos/home
Environment=XDG_RUNTIME_DIR=/run/moonlightos
Environment=WAYLAND_DISPLAY=wayland-0
EnvironmentFile=-/run/moonlightos/session.env
ExecStart=/usr/libexec/moonlightos-osk-session
KillMode=control-group
TimeoutStopSec=5
NoNewPrivileges=yes
StandardOutput=journal+console
StandardError=journal+console
