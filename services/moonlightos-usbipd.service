[Unit]
Description=MoonlightOS USB/IP daemon (no devices exported by default)
Requires=moonlightos-firewall.service
After=moonlightos-firewall.service moonlightos-network-ready.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStartPre=/sbin/modprobe usbip_host
ExecStart=/usr/sbin/usbipd --foreground
ExecStopPost=/usr/sbin/moonlightos-usbip unbind-all
Restart=on-failure
RestartSec=2
StandardOutput=append:/var/log/moonlightos/usbipd.log
StandardError=append:/var/log/moonlightos/usbipd.log

[Install]
WantedBy=multi-user.target
