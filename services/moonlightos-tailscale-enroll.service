[Unit]
Description=Enroll MoonlightOS in Tailscale
Wants=network-online.target
After=network-online.target tailscaled.service

[Service]
Type=oneshot
ExecStart=/usr/sbin/moonlightos-tailscale enroll
TimeoutStartSec=12min
StandardOutput=append:/var/log/moonlightos/tailscale.log
StandardError=append:/var/log/moonlightos/tailscale.log
