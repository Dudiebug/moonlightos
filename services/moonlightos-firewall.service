[Unit]
Description=MoonlightOS USB/IP firewall policy
After=network-pre.target
Before=moonlightos-usbipd.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/moonlightos-firewall apply
ExecReload=/usr/libexec/moonlightos-firewall apply
RemainAfterExit=yes
StandardOutput=append:/var/log/moonlightos/firewall.log
StandardError=append:/var/log/moonlightos/firewall.log

[Install]
WantedBy=multi-user.target
