[Unit]
Description=MoonlightOS QEMU-only application smoke driver
After=moonlightos-launcher.service
Wants=moonlightos-launcher.service
ConditionPathExists=/sys/firmware/qemu_fw_cfg/by_name/opt/moonlightos.smoke/raw

[Service]
Type=oneshot
ExecStart=/usr/libexec/moonlightos-qemu-smoke
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=graphical.target
