[Unit]
Description=MoonlightOS chiaki-ng client
After=moonlightos-launcher.service moonlightos-network-ready.service
ConditionFileIsExecutable=/opt/moonlightos/apps/chiaki-ng.AppImage
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=moonlightos
Group=moonlightos
SupplementaryGroups=audio input render video
Environment=HOME=/var/lib/moonlightos/home
Environment=XDG_CONFIG_HOME=/var/lib/moonlightos/home/.config
Environment=XDG_DATA_HOME=/var/lib/moonlightos/home/.local/share
Environment=XDG_CACHE_HOME=/var/lib/moonlightos/home/.cache
Environment=XDG_RUNTIME_DIR=/run/moonlightos
Environment=WAYLAND_DISPLAY=wayland-0
Environment=QT_QPA_PLATFORM=wayland
Environment=SDL_AUDIODRIVER=pipewire
ExecStart=/usr/libexec/moonlightos-run-app chiaki-ng
Restart=on-failure
RestartSec=2
StandardOutput=append:/var/log/moonlightos/chiaki-ng.log
StandardError=append:/var/log/moonlightos/chiaki-ng.log
