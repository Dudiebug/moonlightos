[Unit]
Description=MoonlightOS wired network readiness
Wants=NetworkManager-wait-online.service
After=NetworkManager-wait-online.service
Before=moonlightos-launcher.service moonlightos-usbipd.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/moonlightos-network-ready
RemainAfterExit=yes
TimeoutStartSec=90
StandardOutput=append:/var/log/moonlightos/network.log
StandardError=append:/var/log/moonlightos/network.log

[Install]
WantedBy=multi-user.target
