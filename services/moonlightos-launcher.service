[Unit]
Description=MoonlightOS controller-friendly launcher
Requires=seatd.service
Wants=moonlightos-audio.service
After=seatd.service moonlightos-audio.service systemd-user-sessions.service
Conflicts=getty@tty1.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=moonlightos
Group=moonlightos
SupplementaryGroups=audio input render video seat
Environment=HOME=/var/lib/moonlightos/home
Environment=XDG_CONFIG_HOME=/var/lib/moonlightos/home/.config
Environment=XDG_DATA_HOME=/var/lib/moonlightos/home/.local/share
Environment=XDG_CACHE_HOME=/var/lib/moonlightos/home/.cache
Environment=XDG_RUNTIME_DIR=/run/moonlightos
Environment=WAYLAND_DISPLAY=wayland-0
Environment=LIBSEAT_BACKEND=seatd
Environment=QT_QPA_PLATFORM=wayland
RuntimeDirectory=moonlightos
RuntimeDirectoryMode=0750
StateDirectory=moonlightos
LogsDirectory=moonlightos
ExecStart=/bin/bash -o pipefail -c '/usr/bin/cage -s -- /usr/libexec/moonlightos-launcher 2>&1 | /usr/bin/tee -a /var/log/moonlightos/launcher.log'
Restart=always
RestartSec=2
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
