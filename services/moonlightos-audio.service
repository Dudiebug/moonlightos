[Unit]
Description=MoonlightOS PipeWire audio session
Wants=bluetooth.service
After=systemd-tmpfiles-setup.service dbus.service bluetooth.service

[Service]
Type=simple
User=moonlightos
Group=moonlightos
SupplementaryGroups=audio
Environment=HOME=/var/lib/moonlightos/home
Environment=XDG_CONFIG_HOME=/var/lib/moonlightos/home/.config
Environment=XDG_RUNTIME_DIR=/run/moonlightos
Environment=PIPEWIRE_RUNTIME_DIR=/run/moonlightos
ExecStart=/usr/libexec/moonlightos-audio
Restart=on-failure
RestartSec=2
StandardOutput=append:/var/log/moonlightos/audio.log
StandardError=append:/var/log/moonlightos/audio.log

[Install]
WantedBy=graphical.target
