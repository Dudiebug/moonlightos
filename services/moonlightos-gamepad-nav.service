[Unit]
Description=MoonlightOS launcher gamepad navigation
After=moonlightos-launcher.service
PartOf=moonlightos-launcher.service

[Service]
Type=simple
User=moonlightos
Group=moonlightos
SupplementaryGroups=input
Environment=XDG_RUNTIME_DIR=/run/moonlightos
EnvironmentFile=-/run/moonlightos/session.env
ExecStart=/usr/libexec/moonlightos-gamepad-nav
Restart=on-failure
RestartSec=2
StandardOutput=append:/var/log/moonlightos/gamepad-nav.log
StandardError=append:/var/log/moonlightos/gamepad-nav.log

[Install]
WantedBy=graphical.target
